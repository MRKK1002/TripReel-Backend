# ========================
# Server
# ========================
PORT=5001
NODE_ENV=production
BASE_URL=https://your-domain.com

# Optional persistent filesystem root for reel videos and generated thumbnails.
# Mount a durable disk here in production; defaults to ./uploads when omitted.
# Existing non-reel uploads continue to be served from ./uploads as a fallback.
# REEL_UPLOAD_ROOT=/var/data/tripreel-uploads

# ========================
# S3 + CloudFront (media storage & CDN)
# ========================
# Set AWS_S3_BUCKET to enable cloud storage. When it is empty, every upload
# stays on local disk and is served by this server — safe for local dev.
# S3 keys mirror the on-disk layout (uploads/videos/..., uploads/operators/...),
# so values stored in MongoDB remain relative "/uploads/..." paths.
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# Public media is served through this CloudFront distribution. Leave empty to
# serve public media from this server instead.
CLOUDFRONT_DOMAIN=

# Credentials are OPTIONAL. Prefer an IAM instance role on EC2 and leave these
# blank — the AWS SDK picks the role up automatically and no long-lived secret
# has to sit on the server. Only set them if a role is not available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Expiry for private operator-document links (S3 presigned GET). Default 3600s.
# PRIVATE_MEDIA_URL_TTL_SECONDS=3600

# CORS — comma-separated list of extra allowed browser origins (no trailing slash).
# Mobile apps / curl / server-to-server send no Origin and are always allowed.
# Defaults already include tripreel.in, operator.tripreel.in, and localhost dev.
# CORS_ORIGINS=https://staging.tripreel.in,https://another-domain.com

# ========================
# MongoDB
# ========================
mongodburl=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>

# ========================
# JWT
# ========================
JWT_SECRET=your_strong_jwt_secret_here
JWT_EXPIRES_IN=7d

# ========================
# Firebase Admin SDK
# Get these from your Firebase project settings > Service accounts > Generate new private key
# ========================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com

# ========================
# Razorpay
# Get from https://dashboard.razorpay.com/app/keys
# ========================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Payments webhook secret — set the SAME value in Razorpay Dashboard → Webhooks
# for the URL https://<your-api-host>/api/payments/webhook (events: order.paid,
# payment.captured). Enables auto-recovery if the app dies before /verify.
RAZORPAY_WEBHOOK_SECRET=your_payments_webhook_secret

RAZORPAYX_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAYX_KEY_SECRET=your_razorpayx_key_secret
RAZORPAYX_ACCOUNT_NUMBER=your_account_number
RAZORPAYX_WEBHOOK_SECRET=your_webhook_secret

# ========================
# Google Sign-In
# Get from Google Cloud Console > APIs & Services > Credentials
# ========================
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# Google Places (legacy) API key — used server-side to proxy place search for
# the "choose your spot" field. Use an unrestricted or IP-restricted key here
# (an Android-app-restricted key will NOT work for server-side calls).
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ========================
# SMTP Email (AWS SES)
# Get SMTP credentials from AWS Console → SES → SMTP Settings
# ========================
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=465
SMTP_USER=your_ses_smtp_access_key
SMTP_PASS=your_ses_smtp_secret_key
SMTP_FROM=no-reply@yourdomain.com

# ========================
# Snapja Integration
# ========================
SNAPJA_API_KEY=your_snapja_api_key
# Optional override; defaults to https://api.snapja.com/api/tripreel/bookings
SNAPJA_API_URL=https://api.snapja.com/api/tripreel/bookings

# ========================
# Development flags
# Set to false before going live!
# ========================
OTP_DEV_MODE=false

# ========================
# SMS (RapidSMS - DLT transactional)
# ========================
RAPIDSMS_API_KEY=your_rapidsms_api_key
RAPIDSMS_SENDER=TRPREL

# OTP dev mode — ONLY for local testing. Set to "false" in production.
# When "true": OTP is returned in the API response (no SMS needed).
# When "false": OTP is ONLY sent via SMS (secure, production behaviour).
OTP_DEV_MODE=false
